# =============================================================================
# 100xAI Backend Configuration - Environment Variables
# =============================================================================

# Database
DATABASE_URL=postgresql+psycopg://100xai:100xai@localhost:5432/100xai

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=dev-secret-change-me-at-least-32-chars
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-at-least-32-chars
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# =============================================================================
# LLM Configuration - Anthropic API (Primary)
# =============================================================================

# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Primary model for content extraction and analysis
# Options: anthropic/claude-haiku-4-5-20251001, openai/gpt-4o, claude-3-opus, etc.
EXTRACTION_MODEL=anthropic/claude-haiku-4-5-20251001

# Fallback model if primary fails
EXTRACTION_MODEL_FALLBACK=openai/gpt-4o

# Model for blog generation pipeline
BLOG_MODEL=anthropic/claude-haiku-4-5-20251001

# =============================================================================
# LLM Configuration - OpenRouter API (Fallback)
# =============================================================================

# Get your API key from: https://openrouter.ai/
# Used as fallback if Anthropic API is not available
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# External APIs
# =============================================================================

# Apify - Web crawling service
# Get API key from: https://console.apify.com/
APIFY_API_KEY=your_apify_api_key_here
# Enable premium features (screenshots, HTML saving) for paid plans
APIFY_PREMIUM_FEATURES=false

# =============================================================================
# SERP Data APIs (Choose ONE option)
# =============================================================================

# Option 1: SerpAPI (RECOMMENDED for Pipeline 2)
# Simpler, cheaper, reliable Google search results
# Get API key from: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# Option 2: DataForSEO (Optional, more expensive)
# Advanced SERP analysis features, required only for Pipeline 1
# Get credentials from: https://dataforseo.com/
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password

# OpenAI - For embeddings and fallback
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Pinecone - Vector database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=100xai-brand-knowledge

# =============================================================================
# Pipeline 3: Content Generation APIs
# =============================================================================

# Leonardo AI - Image generation service
# Get API key from: https://cloud.leonardo.ai/
LEONARDO_API_KEY=your_leonardo_api_key_here

# Placid - Branded template composition (OPTIONAL)
# Get API key from: https://placid.app/
PLACID_API_KEY=your_placid_api_key_here

# =============================================================================
# Model Selection Examples
# =============================================================================

# Latest models (recommended):
# EXTRACTION_MODEL=anthropic/claude-haiku-4-5-20251001
# EXTRACTION_MODEL_FALLBACK=openai/gpt-4o
# BLOG_MODEL=anthropic/claude-haiku-4-5-20251001

# Cost-optimized setup:
# EXTRACTION_MODEL=claude-3-5-haiku-20241022
# EXTRACTION_MODEL_FALLBACK=claude-3-haiku
# BLOG_MODEL=claude-3-5-haiku-20241022

# Maximum capability:
# EXTRACTION_MODEL=claude-3-opus
# EXTRACTION_MODEL_FALLBACK=claude-3-5-sonnet-20241022  
# BLOG_MODEL=claude-3-opus

# Legacy/compatibility:
# EXTRACTION_MODEL=claude-3-5-sonnet
# EXTRACTION_MODEL_FALLBACK=claude-3-haiku
# BLOG_MODEL=claude-2

# =============================================================================
# Application Settings  
# =============================================================================

APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=INFO
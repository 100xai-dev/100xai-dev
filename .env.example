# Application
APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=INFO

# Database / queues
DATABASE_URL=postgresql+psycopg://100xai:100xai@localhost:5432/100xai
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=replace-with-a-strong-random-string-at-least-32-chars
JWT_EXPIRY_HOURS=24

# Token encryption
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1

# LLM / embeddings / vectors
OPENROUTER_API_KEY=
EXTRACTION_MODEL=anthropic/claude-3-5-sonnet
EXTRACTION_MODEL_FALLBACK=openai/gpt-4o
EXTRACTION_MAX_TOKENS=4000
EXTRACTION_TEMPERATURE=0.3
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PINECONE_API_KEY=
PINECONE_INDEX_NAME=100xai-brand-knowledge

# Research / crawling
CRAWLER_USER_AGENT=100xAI-Crawler/1.0 (+https://100xai.example/bot)
CRAWLER_MAX_PAGES=12
CRAWLER_PAGE_TIMEOUT_SEC=20
CRAWLER_HOST_DELAY_SEC=1
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Object storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=100xai-uploads
S3_REGION=us-east-1

# Publishing / channels
UNIPILE_API_KEY=
UNIPILE_DSN=
VAPI_API_KEY=
LEONARDO_API_KEY=
PLACID_API_KEY=

# First CMS connector
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Frontend admin panel (Next.js)
# BACKEND_URL is read by Next server components and the /api/* proxy route.
# API_TOKEN is server-only; never set NEXT_PUBLIC_API_TOKEN — it would leak to the browser bundle.
BACKEND_URL=http://localhost:8000
API_TOKEN=
# Optional: set to "true" to serve in-app mock brands instead of calling the backend.
NEXT_PUBLIC_DEMO_MODE=
